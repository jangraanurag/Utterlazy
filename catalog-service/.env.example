# ─── App ───
APP_NAME=UtterLazy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ───
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (MySQL) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_catalog
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcasting (Laravel Reverb) ───
BROADCAST_CONNECTION=reverb

# ─── Filesystem ───
FILESYSTEM_DISK=local

# ─── Queue ───
QUEUE_CONNECTION=database

# ─── Cache ───
CACHE_STORE=database

# ─── Redis ───
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Event Bus (Outbox) ───
# OUTBOX_TRANSPORT=redis|kafka (dev: redis stream, prod: kafka)
OUTBOX_TRANSPORT=redis
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=utterlazy.
KAFKA_DLQ_SUFFIX=.dlq
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_SECONDS=1
OUTBOX_MAX_RETRIES=5

# ─── Service-to-service token (whatsapp-service → catalog) ───
SERVICE_TOKEN=

# ─── Wave 2 shadow (Java order-command). Keep OFF in production until parity. ───
ORDER_COMMAND_URL=http://order-command:8003
ORDER_COMMAND_SHADOW_ENABLED=false

# ─── ONDC seller adapter (disabled by default; signed search only) ───
ONDC_ENABLED=false
ONDC_REQUIRE_SIGNATURE=true
ONDC_CALLBACK_ENABLED=false
ONDC_SUBSCRIBER_ID=
ONDC_KEY_ID=
ONDC_PRIVATE_KEY=
ONDC_BPP_ID=
ONDC_BPP_URI=
# JSON map: {"subscriber|key|ed25519":"base64-public-key"}
ONDC_REGISTRY_KEYS=

# ─── Safety partner (insurance / emergency response). Empty = disabled. ───
SOS_PARTNER_WEBHOOK=

# ─── OpenSearch organic search (disabled by default; MySQL fallback) ───
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=utterlazy_restaurants

# ─── Wave 3 organic ranker. Keep OFF until the ranker profile is up. ───
RANKER_ENABLED=false
RANKER_URL=http://ranker:8010

# ─── Wave 3 analytics (ClickHouse). Keep OFF until the analytics profile is up. ───
ANALYTICS_ENABLED=false
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=utterlazy
# mysql | clickhouse (clickhouse falls back to MySQL on empty/error)
ANALYTICS_COMMAND_CENTER_SOURCE=mysql

# ─── Wave 2 cutover (fail-closed: all three must agree) ───
ORDER_COMMAND_CUTOVER_ENABLED=false
ORDER_COMMAND_CUTOVER_READY=false
ORDER_COMMAND_CITIES=
ORDER_COMMAND_RESTAURANTS=

# ─── Laravel Reverb (WebSocket) ───
REVERB_APP_KEY=utterlazy_reverb_key_2024
REVERB_APP_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Mail ───
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── S3 / Object Storage ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Frontend ───
VITE_APP_NAME="${APP_NAME}"

# ─── SMS (Fast2SMS) ───
FAST2SMS_API_KEY=

# ─── AI (Google Gemini) ───
GEMINI_API_KEY=

# ─── Maps (Ola Maps) ───
OLA_MAPS_API_KEY=

# ─── Payments ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Voice/Video Calls (EnableX) ───
ENABLEX_APP_ID=
ENABLEX_APP_KEY=

# ─── Voice Assistants ───
GOOGLE_ASSISTANT_PROJECT_ID=utterlazy
ALEXA_SKILL_ID=
DIALOGFLOW_WEBHOOK_SECRET=

# ─── Firebase Cloud Messaging ───
FCM_PROJECT_ID=utterlazy
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# ─── Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175
SESSION_DOMAIN=localhost
