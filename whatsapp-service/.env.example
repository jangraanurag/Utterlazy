APP_NAME="UtterLazy WhatsApp Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=food_whatsapp
DB_USERNAME=root
DB_PASSWORD=secret

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis

# ─── Catalog service (order/catalog source of truth) ───
CATALOG_SERVICE_URL=http://catalog-service:8001
SERVICE_TOKEN=

# ─── Event bus (same cluster as catalog) ───
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_PREFIX=utterlazy.
OUTBOX_TRANSPORT=redis
EVENT_BUS_DRIVER=redis
EVENT_BUS_CONSUMER=whatsapp-service

# ─── Catalog payment screen (prepaid link sent in chat) ───
WA_PAYMENT_LINK_BASE=https://utterlazy.com/pay

# ─── Meta WhatsApp Cloud API ───
WHATSAPP_PROVIDER=meta_cloud
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=utterlazy_wa_webhook
META_API_VERSION=v22.0
META_API_BASE=https://graph.facebook.com

# ─── AI intent routing (Gemini tool schema) ───
GEMINI_API_KEY=

# ─── WhatsApp product rules ───
WA_SESSION_TTL_MINUTES=30
WA_INTENT_CONFIDENCE_THRESHOLD=0.75
WA_TIP_MAX=500
